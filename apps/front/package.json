{
  "name": "@hismia/front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-3000}",
    "build": "next build",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "check": "vitest run && tsc --noEmit --incremental false && eslint src --max-warnings=0 && node --test next.config.test.mjs scripts/lint-policy.test.mjs",
    "start": "next start -p ${PORT:-3000}"
  },
  "dependencies": {
    "@hismia/types": "workspace:*",
    "@hismia/validation": "workspace:*",
    "@hookform/resolvers": "3.10.0",
    "@supabase/supabase-js": "2.117.2",
    "next": "^15.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "7.62.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
