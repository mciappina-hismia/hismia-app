# EditorConfig helps maintain consistent coding styles across editors.
# See https://editorconfig.org for the spec and editor support.
#
# This file mirrors `.prettierrc.json` so the two never fight each
# other: `indent_size = 2` matches `tabWidth: 2`; `end_of_line = lf`
# matches `endOfLine: "lf"`. When both files are present, prettier
# reads editorconfig first and falls back to its own config.
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown hard-breaks (`  \n` renders as <br>) need two trailing
# spaces. Do not trim them.
[*.md]
trim_trailing_whitespace = false

# Make rules require literal tabs for recipe lines.
[Makefile]
indent_style = tab
